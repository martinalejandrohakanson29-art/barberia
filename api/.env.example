# Postgres de Railway (Connection string). En Railway usar la variable de referencia ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:password@localhost:5432/arcanus

# Secreto para firmar sesiones. Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=cambiame-por-un-secreto-largo-y-aleatorio

# URL pública donde corre esta API (sin barra final)
BETTER_AUTH_URL=http://localhost:3000

# Origen del frontend permitido para CORS (el sitio estático)
CLIENT_ORIGIN=http://localhost:8080

# Google OAuth — crear credenciales en https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Puerto (Railway lo inyecta automáticamente)
PORT=3000
